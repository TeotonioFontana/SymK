{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://symk.foundation/schema/vocab.schema.json",
  "title": "SymK Vocabulary Document",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "description", "enums"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "imports": {
      "type": "array",
      "items": { "$ref": "#/$defs/importRef" },
      "default": []
    },
    "enums": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^[a-zA-Z][a-zA-Z0-9_.-]*$": { "$ref": "#/$defs/enumDef" }
      }
    }
  },
  "$defs": {
    "importRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
        }
      }
    },
    "enumDef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "values"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "values": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "patternProperties": {
            "^[-a-zA-Z0-9_.]+$": { "$ref": "#/$defs/enumValueDef" }
          }
        }
      }
    },
    "enumValueDef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "description"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "deprecated": { "type": "boolean", "default": false }
      }
    }
  }
}
